# Get a free API key at https://www.themoviedb.org/settings/api
# Optional — you can also set the key in the app under Settings → TMDB API
TMDB_API_KEY=
TMDB_REGION=US

# Daily job schedule (24-hour clock, server local time)
SCHEDULER_ENABLED=true
PROVIDER_REFRESH_HOUR=2
METADATA_RESCAN_HOUR=3

# Seconds to wait between titles during background metadata jobs (default 1.0)
METADATA_FETCH_DELAY_SECONDS=1.0
